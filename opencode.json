{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/opencode-secrets/github_pat}",
          "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
        }
      }
    }
  }
}
